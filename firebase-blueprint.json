{
  "entities": {
    "candidates": {
      "title": "Candidates",
      "description": "Candidates undergoing pre-onboarding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "accessCode": { "type": "string" },
        "joiningDate": { "type": "string" },
        "formData": { "type": "object" },
        "documents": { "type": "array" },
        "formStatus": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "resumeFileName": { "type": "string" },
        "resumeUploadedAt": { "type": "string" },
        "offerLetterUrl": { "type": "string" },
        "offerLetterFileName": { "type": "string" },
        "offerLetterUploadedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "emailTemplates": {
      "title": "Email Templates",
      "description": "Customizable pre-onboarding email templates per stage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "greeting": { "type": "string" },
        "blocks": { "type": "array" },
        "signoff": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "subject", "greeting", "blocks", "signoff"]
    },
    "settings": {
      "title": "Application Settings",
      "description": "Global settings such as resource links",
      "type": "object",
      "properties": {
        "links": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": "candidates",
      "description": "Candidates undergoing pre-onboarding, managed by HR"
    },
    "/emailTemplates/{templateId}": {
      "schema": "emailTemplates",
      "description": "Stage-wise customizable email templates"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Global settings and resource links"
    }
  }
}
