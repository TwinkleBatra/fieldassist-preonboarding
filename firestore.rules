rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isHR() {
      return request.auth != null && (
        (
          request.auth.token.email != null && (
            request.auth.token.email.lower() == 'twinkle.verma@fieldassist.com' ||
            request.auth.token.email.lower() == 'twinkle.verma@flick2know.com' ||
            exists(/databases/$(database)/documents/hrAdmins/$(request.auth.token.email.lower()))
          )
        ) ||
        exists(/databases/$(database)/documents/hrAdmins/$(request.auth.uid))
      );
    }

    match /hrAdmins/{adminEmail} {
      allow read: if isHR();
      allow create: if isHR();
      allow update: if false;
      allow delete: if isHR() &&
        adminEmail.lower() != 'twinkle.verma@fieldassist.com' &&
        adminEmail.lower() != 'twinkle.verma@flick2know.com';
    }

    match /candidates/{candidateId} {
      allow create: if isHR() || (
        request.resource.data.id == candidateId &&
        request.resource.data.name is string &&
        request.resource.data.email is string
      );

      allow delete: if isHR();

      allow get: if isHR() || resource.data.accessCode != null || true;

      allow list: if isHR() || request.query.limit <= 100;

      allow update: if isHR() || (
        request.resource.data.id == candidateId &&
        request.resource.data.name is string &&
        request.resource.data.email is string
      );
    }

    match /emailTemplates/{templateId} {
      allow read: if true;
      allow write: if isHR() || true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isHR() || true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
