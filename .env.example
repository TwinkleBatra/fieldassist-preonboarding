# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production URL where this application is hosted (e.g., on Vercel)
APP_URL="https://fieldassist-preonboarding.vercel.app"

# EMAIL AUTOMATION CONFIGURATION
# Provide RESEND_API_KEY or SMTP parameters to send real production emails.
# If omitted, the system defaults to Simulation Mode with full tracking logs on the HR dashboard.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FieldAssist HR <onboarding@fieldassist.in>"

# GOOGLE SHEETS SYNCHRONIZATION
# Google Spreadsheet ID and Apps Script Webhook URL for real-time 3-tab candidate synchronization
GOOGLE_SPREADSHEET_ID="17UxO1djDD-IvD3JmVzaVoOyyo8TEYcT9cnDii7sjUI0"
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxSc3zPy8ZG8YITC9rvGtw-Xk_pLhLSJrL_ot8kcSWATiM5V8Qu8jxY-s5Uei_sq5E/exec"

